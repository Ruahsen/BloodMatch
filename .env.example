APP_ENV=local
APP_DEBUG=false
# Production MUST set APP_SECURE_COOKIES=true (requires HTTPS) so the
# session cookie is never sent over plaintext. Local XAMPP development
# over plain HTTP keeps this false.
APP_SECURE_COOKIES=false
# Serve the API behind HTTPS in production and enable HSTS at the web
# server / reverse proxy layer (the PHP app does not emit HSTS itself so
# local HTTP development keeps working).
APP_CORS_ORIGINS=http://localhost:5173
# Security posture notes (see docs/api.md "Security notes"):
# - Sessions expire after 12h idle (AuthMiddleware::IDLE_TIMEOUT_SECONDS).
# - CSRF tokens rotate at login; clients must adopt the token returned by
#   POST /api/login (or re-fetch GET /api/csrf) before mutating.
# - Password resets, deactivations, and role/chapter changes bump
#   users.session_version, revoking previously issued sessions.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=
DB_USER=
DB_PASS=

# SMTP (leave MAIL_HOST empty to skip email delivery)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=bloodmatch@localhost
# Optional email settings (empty = default). MAIL_USERNAME/MAIL_PASSWORD and
# MAIL_FROM_ADDRESS are accepted as aliases of MAIL_USER/MAIL_PASS/MAIL_FROM.
MAIL_FROM_NAME=BloodMatch
# Transport encryption: empty (plain), tls, or ssl.
MAIL_ENCRYPTION=
# SMTP connect/send timeout in seconds.
MAIL_TIMEOUT=10
# Absolute frontend base URL used for links inside notification emails.
# Defaults to the first APP_CORS_ORIGINS entry when empty.
FRONTEND_URL=
# Safe local-testing transport: when set to a writable directory, notification
# emails are written to disk as .eml files instead of being sent via SMTP.
# Leave empty in production. Example: logs/mail-capture
MAIL_CAPTURE_DIR=
